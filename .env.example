DATABASE_URL=postgresql+psycopg://finresearch:your_password@localhost:5432/finresearch
# Free key from https://aistudio.google.com/apikey
GEMINI_API_KEY=
# SEC EDGAR requires an app name and a contact email, e.g. "FinResearch AI you@yourdomain"
SEC_USER_AGENT=
# Optional: "stub" runs the job queue with fake stages and no external calls
# PIPELINE=stub

# Billing (ADR 0009). Set to "paid" once billing is linked in AI Studio / Google Cloud: calls are then marked
# billed in the cost ledger and the caps below start blocking new research when they are spent.
# GEMINI_BILLING=free
# BUDGET_DAILY_USD=1.00
# BUDGET_MONTHLY_USD=5.00
# Optional per-model requests-per-minute ceilings (JSON), e.g. GEMINI_MODEL_RPM={"gemini-3.6-flash": 5}
